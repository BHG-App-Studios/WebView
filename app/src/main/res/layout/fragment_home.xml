<?xml version="1.0" encoding="utf-8"?>
<!--
    Build Wizard fragment.
    Structure:
      • 64dp top bar  (back arrow + title + step-dot indicator)
      • ViewPager2    fills remaining space (4 steps)
      • Floating Next/Build button at the bottom
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_content_bg">

    <!-- ── Top bar ───────────────────────────────────────────────────── -->

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_bar_height"
            android:background="@drawable/bg_top_bar"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingTop="9dp"
            android:paddingEnd="16dp"
            android:paddingBottom="9dp">

            <!-- Back / menu button -->
            <ImageButton
                android:id="@+id/topBarBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_right"
                android:rotation="180"
                android:visibility="invisible"
                app:tint="@color/top_bar_icon" />

            <!-- Hamburger (visible only on step 1) -->
            <ImageButton
                android:id="@+id/topBarMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Open menu"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/top_bar_icon" />

            <!-- Title -->
            <TextView
                android:id="@+id/topBarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_bold"
                android:text="Build App"
                android:textColor="@color/top_bar_title"
                android:textSize="@dimen/text_size_20"
                android:textStyle="bold" />
        </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ── ViewPager2 (3 wizard steps) ─────────────────────────────── -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/wizardPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="88dp"
            android:clipToPadding="false" />

    <!-- ── Floating Next button (bottom-right) ──────────────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        style="@style/Widget.App.Button"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="112dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="Next"
        android:textSize="15sp"
        app:icon="@drawable/ic_arrow_forward"
        app:iconGravity="end"
        app:iconPadding="8dp" />
    </FrameLayout>

</LinearLayout>
