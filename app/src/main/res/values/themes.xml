<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.WebsiteAppBuilder" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/brand_violet</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>

        <!-- System bars: edge-to-edge, icons adapt to theme -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:navigationBarDividerColor">@android:color/transparent</item>

        <!-- Typography: Roboto everywhere -->
        <item name="fontFamily">@font/roboto</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="textAppearanceHeadlineMedium">@style/Text.Headline</item>
        <item name="textAppearanceHeadlineSmall">@style/Text.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/Text.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/Text.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/Text.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/Text.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/Text.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/Text.LabelLarge</item>

        <!-- Component shapes -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
    </style>

    <!-- Splash (Android 12+ compatible via core-splashscreen) -->
    <style name="Theme.WebsiteAppBuilder.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.WebsiteAppBuilder</item>
    </style>

    <!-- ============ Typography scale ============ -->
    <style name="Text.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/roboto</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textFontWeight">700</item>
    </style>
    <style name="Text.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/roboto</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textFontWeight">700</item>
    </style>
    <style name="Text.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/roboto</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="Text.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/roboto</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="Text.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/roboto</item>
        <item name="android:fontFamily">@font/roboto</item>
    </style>
    <style name="Text.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/roboto</item>
        <item name="android:fontFamily">@font/roboto</item>
    </style>
    <style name="Text.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/roboto</item>
        <item name="android:fontFamily">@font/roboto</item>
    </style>
    <style name="Text.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/roboto</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <!-- ============ Components ============ -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/roboto</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/field_radius</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>

    <style name="Widget.App.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/field_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/field_radius</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>

    <style name="BottomNav.ActiveText" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/roboto</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="BottomNav.InactiveText" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/roboto</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="App.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_container</item>
    </style>

    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Drawer -->
    <style name="DrawerSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="DrawerItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="drawableTint">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
