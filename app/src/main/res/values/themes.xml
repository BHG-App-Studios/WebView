<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.WebsiteAppBuilder" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/brand_violet</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>

        <!-- System bars: edge-to-edge, icons adapt to theme -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>

        <!-- Android 10+ "force dark": never auto-darken. We own light/dark
             through the DayNight resources, so the OS must not re-tint the
             light theme (which made Light mode look gray). -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>

        <!-- Typography: Roboto everywhere -->
        <item name="fontFamily">@font/roboto</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="textAppearanceHeadlineMedium">@style/Text.Headline</item>
        <item name="textAppearanceHeadlineSmall">@style/Text.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/Text.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/Text.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/Text.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/Text.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/Text.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/Text.LabelLarge</item>

        <!-- Component shapes -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialSwitchStyle">@style/Widget.App.Switch</item>
        <item name="switchStyle">@style/Widget.App.Switch</item>
    </style>

    <!-- Splash (Android 12+ compatible via core-splashscreen) -->
    <style name="Theme.WebsiteAppBuilder.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.WebsiteAppBuilder</item>
    </style>

    <!-- ============ Typography scale ============
         Weight is chosen by pointing at the specific Roboto weight file, which
         works on every API (android:textFontWeight needs API 28). -->
    <style name="Text.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
    </style>
    <style name="Text.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
    </style>
    <style name="Text.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:fontFamily">@font/roboto_semibold</item>
    </style>
    <style name="Text.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:fontFamily">@font/roboto_semibold</item>
    </style>
    <style name="Text.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>
    <style name="Text.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>
    <style name="Text.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>
    <style name="Text.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:fontFamily">@font/roboto_semibold</item>
    </style>

    <!-- ============ Components ============ -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/field_radius</item>
    </style>

    <!-- Segmented toggle segment (build type / output format / signing key).
         Clean neutral look: strong text on a soft grey fill when selected, muted
         text with a hairline outline otherwise — no baseline Material lavender. -->
    <style name="Widget.App.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/toggle_btn_bg</item>
        <item name="android:textColor">@color/toggle_btn_fg</item>
        <item name="iconTint">@color/toggle_btn_fg</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/roboto_semibold</item>
    </style>

    <!-- Neutral outlined action button (upload / create keystore): readable
         on-surface label, muted icon, hairline outline — no brand-blue accent. -->
    <style name="Widget.App.OutlinedButton.Neutral" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/roboto_semibold</item>
    </style>

    <style name="Widget.App.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switch_track_tint</item>
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackDecorationTint">@color/switch_track_decoration_tint</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>

    <style name="Widget.App.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/field_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/field_radius</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>

    <!-- Bottom nav labels. Parent is TextAppearance.MaterialComponents.Caption, the same
         one the reference app uses, so the label's line height — and therefore the whole
         bar height — comes out identical. -->
    <style name="BottomNav.ActiveText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/roboto_bold</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BottomNav.InactiveText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="App.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_container</item>
        <item name="android:width">54dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- A build card's launcher-icon preview: a rounded square, the shape Android
         draws a launcher icon in, so the card shows the app as the device would. -->
    <style name="AppIconImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22%</item>
    </style>

    <!-- Drawer -->
    <style name="DrawerSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="DrawerItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="drawableTint">?attr/colorOnSurfaceVariant</item>
    </style>
    <!-- One item in the floating capsule nav. A MaterialButton whose icon is always
         shown; the text label is only present on the selected item (added/removed at
         runtime) so the pill grows to fit it. Background is the pill selector: filled
         brand when checked, transparent otherwise. -->
    <style name="Widget.App.NavItem" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/nav_item_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">@dimen/nav_item_icon_padding</item>
        <item name="android:paddingEnd">@dimen/nav_item_icon_padding</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">@dimen/nav_item_icon_size</item>
        <item name="iconTint">@color/nav_item_fg</item>
        <item name="android:textColor">@color/nav_item_fg</item>
        <item name="backgroundTint">@color/nav_item_bg</item>
        <item name="cornerRadius">@dimen/nav_pill_radius</item>
        <item name="rippleColor">@color/nav_item_fg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/roboto_semibold</item>
        <item name="android:fontFamily">@font/roboto_semibold</item>
        <item name="elevation">0dp</item>
    </style>
    <!-- Floating bottom sheet: transparent sheet background so the rounded card
         (with its own margins) floats over the scrim. -->
    <style name="ThemeOverlay.App.FloatingSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.FloatingSheet</item>
    </style>
    <style name="Widget.App.FloatingSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <!-- Full-screen dialog used by the logo creator. -->
    <style name="Theme.WebsiteAppBuilder.FullScreenDialog" parent="Theme.WebsiteAppBuilder">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">@color/nav_bar_bg</item>
    </style>

    <!-- Logo creator: uppercase section header + small tile caption. -->
    <style name="Logo.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
    <style name="Logo.Caption" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
