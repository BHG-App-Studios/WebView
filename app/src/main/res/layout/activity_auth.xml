<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/authRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/help_button"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        android:layout_gravity="end"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/help"
        android:src="@drawable/help_24px"
        app:tint="?attr/colorOnSurfaceVariant" />
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Animated hero: Website  →  Android app -->
    <LinearLayout
        android:id="@+id/heroRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Website (globe) -->
        <LinearLayout
            android:id="@+id/heroGlobe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp">

                <View
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_circle_primary" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/globe_24px"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/auth_hero_web"
                android:textSize="12sp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Animated arrow -->
        <ImageView
            android:id="@+id/heroArrow"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_arrow_forward"
            app:tint="?attr/colorPrimary" />

        <!-- Android app (apk) -->
        <LinearLayout
            android:id="@+id/heroApk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp">

                <View
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:background="@drawable/bg_logo_tile" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/apk_24px"
                    app:tint="@color/brand_on_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/auth_hero_app"
                android:textSize="12sp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="@string/auth_title"
        android:textSize="30sp"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:layout_marginHorizontal="28dp"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:text="@string/auth_subtitle"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant" />


    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1" />


    <!-- Button + centered spinner overlay. The spinner sits ON the button so
         showing it never changes the button size or shifts the layout. -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signInButton"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="248dp"
            android:text="@string/sign_in_with_google"
            android:textColor="@color/google_btn_text"
            android:textSize="15sp"
            android:fontFamily="@font/roboto_medium"
            android:letterSpacing="0.01"
            android:textAllCaps="false"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            app:backgroundTint="@color/google_btn_bg"
            app:cornerRadius="30dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_google_logo"
            app:iconGravity="textStart"
            app:iconPadding="14dp"
            app:iconSize="22dp"
            app:iconTint="@null"
            android:stateListAnimator="@null"
            app:rippleColor="?attr/colorControlHighlight"
            app:strokeColor="@color/google_btn_stroke"
            app:strokeWidth="1dp" />

        <ProgressBar
            android:id="@+id/authProgress"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:elevation="12dp"
            android:indeterminateTint="@color/google_btn_text"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/termsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:textSize="11sp"
        android:lineSpacingExtra="3dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textColorLink="?attr/colorPrimary" />

</LinearLayout>
