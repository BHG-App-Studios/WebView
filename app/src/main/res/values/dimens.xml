<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="screen_margin">20dp</dimen>
    <dimen name="card_radius">20dp</dimen>
    <dimen name="field_radius">14dp</dimen>

    <!-- Top bar (matches reference production app): 64dp tall, solid background,
         8dp side padding, 40dp icon buttons with 8dp internal padding, 20sp bold title. -->
    <dimen name="main_bar_height">64dp</dimen>
    <dimen name="text_size_20">20sp</dimen>

    <!-- Floating bottom navigation capsule -->
    <dimen name="nav_pill_margin">16dp</dimen>
    <dimen name="nav_pill_radius">32dp</dimen>
    <dimen name="nav_item_height">48dp</dimen>
    <dimen name="nav_item_icon_size">24dp</dimen>
    <dimen name="nav_item_icon_padding">8dp</dimen>

    <!-- Footprint of the floating capsule measured from the screen edge, above the
         system gesture/nav bar: nav_item_height (48) + capsule top+bottom padding (12)
         + nav_pill_margin (16). The entry screen reserves this so its card centres in
         the band between the top bar and the capsule. -->
    <dimen name="entry_capsule_clearance">92dp</dimen>
</resources>
