<?xml version="1.0" encoding="utf-8"?>
<!-- Step 1: App name + package name. The URL is collected on the entry screen. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none"
    android:paddingBottom="80dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <!-- Step label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Step 1 of 4"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:fontFamily="@font/roboto_semibold"
            android:textColor="@color/brand_primary"
            android:textAllCaps="true"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="App Details"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center"
            android:fontFamily="@font/roboto_bold" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Give your app a name. The package name is optional."
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- App name field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/appNameLayout"
            style="@style/Widget.App.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="App Name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/appNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:maxLength="50"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Package name field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/packageLayout"
            style="@style/Widget.App.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/label_package_name"
            app:helperTextEnabled="true"
            app:helperText="@string/package_helper">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/packageInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto"
                android:inputType="text"
                android:maxLines="1"
                android:maxLength="100"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Version fields: name + code. Applied to the generated app's
             versionName / versionCode, saved to Firestore, and used later
             so an update build can reuse and bump them. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:baselineAligned="false">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/versionNameLayout"
                style="@style/Widget.App.TextField"
                android:layout_width="0dp"
                android:layout_weight="1.4"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:hint="@string/label_version_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/versionNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto"
                    android:inputType="text"
                    android:maxLines="1"
                    android:maxLength="20"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/versionCodeLayout"
                style="@style/Widget.App.TextField"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:hint="@string/label_version_code">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/versionCodeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto"
                    android:inputType="number"
                    android:maxLines="1"
                    android:maxLength="9"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/version_helper"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="6dp"
            android:paddingStart="4dp" />


    </LinearLayout>
</androidx.core.widget.NestedScrollView>
