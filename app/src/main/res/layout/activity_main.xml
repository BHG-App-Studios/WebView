<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_content_bg">

    <!-- The drawer layout's background paints the status-bar strip; the content
         background (home_content_bg) reaches the bottom edge and paints the bottom
         system-bar strip. The nav now floats above that content rather than owning
         the bottom edge, so both strips are the same content colour — a single
         continuous surface behind a floating capsule. -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Fragment fills the whole area. Its bottom padding (applied at runtime =
             capsule height + margins + system inset) keeps scrollable content clear
             of the floating capsule. Each fragment owns its own 64dp top bar. -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating capsule nav, centred at the bottom with a margin so it hovers
             over the content. Bottom margin is topped up at runtime with the system
             inset so it never sits under the gesture bar. -->
        <include
            android:id="@+id/bottomNav"
            layout="@layout/view_bottom_nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/nav_pill_margin" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include
        android:id="@+id/navigationDrawer"
        layout="@layout/drawer_panel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
