<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher / splash. The splash glyph is white, so the splash uses the deeper primary
         rather than the vivid #00A3FF — white on #00A3FF is only about 2.7:1. -->
    <color name="ic_launcher_background">#00A3FF</color>
    <color name="splash_background">#0077D4</color>

    <!-- Accent: the logo's sky blue. Light mode takes the deeper tone so white button labels
         and primary-coloured text clear 4.5:1 on light surfaces; dark mode takes the vivid
         tone, which reads at roughly 8:1 on the dark surface. -->
    <color name="brand_primary">#0077D4</color>
    <color name="brand_primary_bright">#00A3FF</color>
    <color name="brand_violet">#00A3FF</color>
    <color name="brand_on_primary">#FFFFFF</color>

    <!-- LIGHT surfaces & text (Google Material light spec) -->
    <color name="bg">#F8F9FA</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#F2F2F2</color>
    <color name="surface_container">#F5F5F5</color>
    <color name="outline">#E0E0E0</color>
    <color name="outline_variant">#EEEEEE</color>
    <color name="text_primary">#202124</color>
    <color name="text_secondary">#5F6368</color>
    <color name="text_tertiary">#9E9E9E</color>

    <!-- Tinted containers (active-tab pill, avatar ring, status circles) -->
    <color name="primary_container">#D6EEFF</color>
    <color name="on_primary_container">#00344F</color>

    <!-- Status -->
    <color name="success">#1E8E3E</color>
    <color name="success_container">#E6F4EA</color>
    <color name="error">#D93025</color>
    <color name="error_container">#FCE8E6</color>
    <color name="warning">#E37400</color>

    <!-- ============ Chrome colour groups ============
         Two surfaces, deliberately different from each other — Google's baseline
         Material palette (background vs. surface):

           Group A  background  #F8F9FA   fragment bg == top bar == status bar
           Group B  surface     #FFFFFF   bottom nav bar == bottom system bar

         status_bar_bg / navigation_bar_bg deliberately mirror their group. Those
         two paint the real system bars only up to API 34; from API 35 both
         window.statusBarColor and window.navigationBarColor are no-ops, and the
         strips are painted by the DrawerLayout background (Group A) and the
         bottom nav container (Group B) instead. Equal values are what make the
         old and new paths agree — change one and change its partner. -->
    <color name="home_content_bg">#F8F9FA</color>
    <color name="top_bar_bg">#F8F9FA</color>
    <color name="status_bar_bg">#F8F9FA</color>

    <color name="nav_bar_bg">#FFFFFF</color>
    <color name="navigation_bar_bg">#FFFFFF</color>

    <!-- Top bar title / icon: the palette's primary and secondary text. -->
    <color name="top_bar_title">#202124</color>
    <color name="top_bar_icon">#5F6368</color>

    <!-- Google sign-in button -->
    <color name="google_btn_bg">#FFFFFF</color>
    <color name="google_btn_stroke">#E0E0E0</color>
    <color name="google_btn_text">#1F1F1F</color>

    <!-- Scrim -->
    <color name="scrim">#66000000</color>
    <color name="nav_capsule_stroke">#1A000000</color>
</resources>
