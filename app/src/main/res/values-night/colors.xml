<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accent (dark): the vivid sky blue. onPrimary is a deep blue rather than white —
         white on #00BFFF is only about 2.2:1, where #00344F on it clears 7:1. -->
    <color name="brand_primary">#00BFFF</color>
    <color name="brand_primary_bright">#5FD3FF</color>
    <color name="brand_violet">#5FD3FF</color>
    <color name="brand_on_primary">#00344F</color>

    <!-- DARK surfaces & text (Google Material dark spec) -->
    <color name="bg">#121212</color>
    <color name="surface">#1E1E1E</color>
    <color name="surface_variant">#2A2A2A</color>
    <color name="surface_container">#242424</color>
    <color name="outline">#3A3A3A</color>
    <color name="outline_variant">#2E2E2E</color>
    <color name="text_primary">#E8EAED</color>
    <color name="text_secondary">#9AA0A6</color>
    <color name="text_tertiary">#8A8A8A</color>

    <!-- Tinted containers -->
    <color name="primary_container">#00456B</color>
    <color name="on_primary_container">#CDE9FF</color>

    <!-- Switch toggles (Dark Mode) -->
    <color name="switch_track_checked">@color/brand_primary</color>
    <color name="switch_thumb_checked">@color/brand_on_primary</color>
    <color name="switch_track_unchecked">#242932</color>
    <color name="switch_track_outline_unchecked">#565E6D</color>
    <color name="switch_thumb_unchecked">#B4BAC6</color>

    <!-- Status -->
    <color name="success">#81C995</color>
    <color name="success_container">#1B3226</color>
    <color name="error">#F28B82</color>
    <color name="error_container">#3A1A1A</color>
    <color name="warning">#FBBF24</color>

    <!-- Chrome colour groups — see values/colors.xml for the full explanation.
         Group A background #121212, Group B surface #1E1E1E. -->
    <color name="home_content_bg">#121212</color>
    <color name="top_bar_bg">#121212</color>
    <color name="status_bar_bg">#121212</color>

    <color name="nav_bar_bg">#1E1E1E</color>
    <color name="navigation_bar_bg">#1E1E1E</color>

    <color name="top_bar_title">#E8EAED</color>
    <color name="top_bar_icon">#9AA0A6</color>

    <!-- Google sign-in button: dark surface with light text in dark mode -->
    <color name="google_btn_bg">#1E1E1E</color>
    <color name="google_btn_stroke">#3A3A3A</color>
    <color name="google_btn_text">#E6E6E6</color>

    <!-- Scrim -->
    <color name="scrim">#99000000</color>
    <color name="nav_capsule_stroke">#1FFFFFFF</color>

    <!-- Selected segment fill for the build-type / output / signing toggles.
         A subtle blue-grey, echoing the download sheet's option surface. -->
    <color name="toggle_selected_bg">#2B2F36</color>
</resources>
