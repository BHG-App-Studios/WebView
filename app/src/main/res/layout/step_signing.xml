<?xml version="1.0" encoding="utf-8"?>
<!-- Step 4 (final): Build type + output format + signing/keystore + Build trigger -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none"
    android:paddingBottom="20dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <!-- Step label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Step 4 of 4"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:fontFamily="@font/roboto_semibold"
            android:textColor="@color/brand_primary"
            android:textAllCaps="true"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Build &amp; Signing"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center"
            android:fontFamily="@font/roboto_bold" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Choose how your app is built and signed, then build."
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- ================= Build type ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_build_type"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/roboto_semibold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/buildTypeToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buildTypeDebug"
                style="@style/Widget.App.ToggleButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/build_type_debug" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buildTypeRelease"
                style="@style/Widget.App.ToggleButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/build_type_release" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/buildTypeHelper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/build_type_debug_helper"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="6dp" />

        <!-- ============ Output format (release only) ============ -->
        <LinearLayout
            android:id="@+id/outputFormatSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_output_format"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="@font/roboto_semibold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/outputToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/outputApk"
                    style="@style/Widget.App.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/output_apk" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/outputAab"
                    style="@style/Widget.App.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/output_aab" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/outputBoth"
                    style="@style/Widget.App.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/output_both" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/output_format_helper"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ================= Signing ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_signing"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/roboto_semibold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/signingToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signingAuto"
                style="@style/Widget.App.ToggleButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/signing_auto" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signingCustom"
                style="@style/Widget.App.ToggleButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/signing_custom" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/signingHelper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/signing_auto_helper"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="6dp" />
        <!-- ========== Custom keystore fields (custom signing only) ========== -->
        <LinearLayout
            android:id="@+id/customKeystoreSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickKeystoreButton"
                style="@style/Widget.App.OutlinedButton.Neutral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:icon="@drawable/ic_arrow_forward"
                android:text="@string/keystore_pick" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createKeystoreButton"
                style="@style/Widget.App.OutlinedButton.Neutral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:icon="@drawable/ic_key"
                android:text="@string/keystore_create" />

            <TextView
                android:id="@+id/keystoreFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/storePwLayout"
                style="@style/Widget.App.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:passwordToggleEnabled="true"
                android:hint="@string/keystore_store_password">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/storePwInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/keyAliasLayout"
                style="@style/Widget.App.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/keystore_key_alias">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/keyAliasInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/keyPwLayout"
                style="@style/Widget.App.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:passwordToggleEnabled="true"
                app:helperTextEnabled="true"
                app:helperText="@string/keystore_key_password_helper"
                android:hint="@string/keystore_key_password">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/keyPwInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Ownership checkbox -->
        <LinearLayout
            android:id="@+id/ownershipLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="top"
            android:clickable="true"
            android:focusable="true">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/ownershipCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:checked="false" />

            <TextView
                android:id="@+id/ownershipText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingBottom="8dp"
                android:layout_marginStart="12dp"
                android:text="I confirm that I own this website or have permission from its owner to create and distribute this app."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Build button — full width, prominent -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buildButton"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:text="Build My App"
            android:textSize="16sp"
            android:fontFamily="@font/roboto_semibold"
            app:icon="@drawable/ic_build"
            app:iconGravity="textStart"
            app:iconPadding="10dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
