<?xml version="1.0" encoding="utf-8"?>
<!-- Icon + label colour for a bottom-nav item: onPrimary over the active pill
     (white in light mode, deep navy in dark, matching brand_on_primary), muted
     secondary text when inactive. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/brand_on_primary" android:state_checked="true" />
    <item android:color="@color/text_secondary" />
</selector>
