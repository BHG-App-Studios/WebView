<?xml version="1.0" encoding="utf-8"?>
<!-- Entry screen (not a numbered step): just the website URL and a full-width
     "Start Building" button. Tapping it pings the URL; only a reachable URL
     advances to Step 1. The bottom nav stays visible on this screen. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none"
    android:paddingBottom="80dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <!-- Hero illustration -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp">

            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_hero_icon"
                android:layout_gravity="center" />

            <View
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_primary" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_globe"
                app:tint="@color/brand_primary" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Convert to App"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center"
            android:fontFamily="@font/roboto_bold" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Enter your website URL to get started."
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <!-- URL field -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/entryUrlLayout"
                style="@style/Widget.App.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Website URL"
                app:startIconDrawable="@drawable/ic_globe"
                app:startIconTint="?attr/colorOnSurfaceVariant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entryUrlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:imeOptions="actionDone"
                    android:paddingEnd="80dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/pasteButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_paste_button"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:layout_marginTop="2.5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="Paste"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startBuildingButton"
                style="@style/Widget.App.Button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_button"
                app:backgroundTint="@null"
                android:text="Start Building"
                android:textSize="15sp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="8dp" />

            <View
                android:id="@+id/startBuildingShadow"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_soft_shadow"
                android:translationX="-100dp"
                android:elevation="2dp" />
        </FrameLayout>

        <!-- Inline progress shown while pinging the URL -->
        <ProgressBar
            android:id="@+id/entryProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Tip card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#0D0077D4"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_build"
                    android:layout_marginEnd="10dp"
                    app:tint="@color/brand_primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Any public website works — e-commerce, blogs, SaaS tools, and more."
                    android:textSize="13sp"
                    android:textColor="@color/brand_primary"
                    android:fontFamily="@font/roboto_regular"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
