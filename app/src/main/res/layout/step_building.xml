<?xml version="1.0" encoding="utf-8"?>
<!-- Step 4: Building / Done screen with animated ring -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <!-- Animated ring frame -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginBottom="32dp">

            <!-- Outer pulse ring (large, animated alpha) -->
            <View
                android:id="@+id/buildPulseOuter"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_hero_icon" />

            <!-- Middle ring -->
            <View
                android:id="@+id/buildPulseMid"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:alpha="0.3"
                android:background="@drawable/bg_circle_primary" />

            <!-- Inner solid circle -->
            <View
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_primary" />

            <!-- Indeterminate progress ring on top of circle -->
            <ProgressBar
                android:id="@+id/buildProgressRing"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/brand_primary"
                android:visibility="visible" />

            <!-- Success / fail icon (hidden until build resolves) -->
            <ImageView
                android:id="@+id/buildResultIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_download"
                android:visibility="gone"
                app:tint="@color/brand_primary" />

            <!-- Build glyph (always shown while building) -->
            <ImageView
                android:id="@+id/buildCenterIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_build"
                app:tint="@color/brand_primary" />
        </FrameLayout>

        <!-- Status heading -->
        <TextView
            android:id="@+id/buildStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Building your app…"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center" />

        <!-- Status detail -->
        <TextView
            android:id="@+id/buildStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="This usually takes a few minutes. Stay on this screen."
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4" />

        <!-- Progress steps row (3 checkpoints) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="8dp">

            <!-- Step: Queued -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp">
                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_primary" />
                    <ImageView
                        android:id="@+id/stepIcon1"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Queued"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:fontFamily="@font/roboto_regular"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Connector line -->
            <View
                android:layout_width="0dp"
                android:layout_weight="0.5"
                android:layout_height="1.5dp"
                android:background="?attr/colorOutlineVariant"
                android:layout_gravity="top"
                android:layout_marginTop="16dp" />

            <!-- Step: Building -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp">
                    <View
                        android:id="@+id/stepBg2"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_step_dot_inactive" />
                    <ProgressBar
                        android:id="@+id/stepProgress2"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/brand_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Building"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:fontFamily="@font/roboto_regular"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Connector line -->
            <View
                android:layout_width="0dp"
                android:layout_weight="0.5"
                android:layout_height="1.5dp"
                android:background="?attr/colorOutlineVariant"
                android:layout_gravity="top"
                android:layout_marginTop="16dp" />

            <!-- Step: Ready -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp">
                    <View
                        android:id="@+id/stepBg3"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_step_dot_inactive" />
                    <ImageView
                        android:id="@+id/stepIcon3"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_download"
                        android:alpha="0.3"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:fontFamily="@font/roboto_regular"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Download button (visible once build is READY) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/downloadButton"
            style="@style/Widget.App.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Download APK"
            android:textSize="15sp"
            android:visibility="gone"
            app:icon="@drawable/ic_download"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

        <!-- New build button (shown when done/failed) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/newBuildButton"
            style="Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Start New Build"
            android:visibility="gone"
            android:fontFamily="@font/roboto_semibold"
            android:textAllCaps="false" />

    </LinearLayout>

</FrameLayout>
