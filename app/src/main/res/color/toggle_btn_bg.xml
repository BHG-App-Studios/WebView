<?xml version="1.0" encoding="utf-8"?>
<!-- Segmented-toggle segment background: a clean neutral fill when selected
     (matching the download sheet's option surface), transparent otherwise —
     no baseline Material lavender. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/toggle_selected_bg" android:state_checked="true" />
    <item android:color="@android:color/transparent" />
</selector>
