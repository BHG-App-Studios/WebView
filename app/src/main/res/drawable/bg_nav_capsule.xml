<?xml version="1.0" encoding="utf-8"?>
<!-- Floating capsule that holds the four nav items. Fully rounded (nav_pill_radius),
     filled with the nav surface colour, with a hairline outline so it reads as a
     distinct floating element over the content. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nav_bar_bg" />
    <corners android:radius="@dimen/nav_pill_radius" />
    <stroke android:width="1dp" android:color="@color/nav_capsule_stroke" />
</shape>
