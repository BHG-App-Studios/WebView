<?xml version="1.0" encoding="utf-8"?>
<!--
    Active Builds tab — a live list of builds currently BUILDING (plus any that
    finished while the user is watching this session). Backed by a Firestore
    snapshot listener. When nothing is active: an empty state that points to the
    My Apps history.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_content_bg"
    android:orientation="vertical">

    <!-- ── Top bar ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/main_bar_height"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp">

        <ImageButton
            android:id="@+id/topBarMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/open_menu"
            android:padding="8dp"
            android:src="@drawable/ic_menu"
            app:tint="@color/top_bar_icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_bold"
            android:text="Active Builds"
            android:textColor="@color/top_bar_title"
            android:textSize="@dimen/text_size_20"
            android:textStyle="bold" />

        <!-- Live status badge -->
        <TextView
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="12sp"
            android:fontFamily="@font/roboto_semibold"
            android:textColor="@color/brand_primary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ── Content ──────────────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Live list of active builds -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/activeList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingTop="4dp"
            android:paddingBottom="88dp"
            android:scrollbars="none"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/activeProgress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="?attr/colorPrimary"
            android:visibility="gone" />

        <!-- ─── Empty state (no active build) ─── -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="120dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:visibility="visible">

            <!-- Glowing icon -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_hero_icon"
                    android:layout_gravity="center" />

                <View
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_primary" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_build"
                    app:tint="@color/brand_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/active_empty_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="@font/roboto_bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/active_empty_subtitle"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/emptyRecentBtn"
                style="@style/Widget.App.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:background="@drawable/bg_gradient_button"
                app:backgroundTint="@null"
                android:text="@string/active_view_recent"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="end"
                app:iconPadding="8dp" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>
